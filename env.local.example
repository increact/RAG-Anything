# Local Development Environment Configuration for macOS
# Copy this file to .env and update with your values

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# RAG-Anything Configuration
# ============================================
PARSER=mineru
PARSE_METHOD=auto
OUTPUT_DIR=/app/output
WORKING_DIR=/app/rag_storage
DISPLAY_CONTENT_STATS=true

# ============================================
# Multimodal Processing
# ============================================
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true

# ============================================
# LLM Configuration (Optional for local dev)
# ============================================
# Note: For document parsing only (markdown extraction),
# LLM is not strictly required. However, for full RAG
# functionality (queries, summaries), LLM is needed.
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=your_openai_api_key_here

# ============================================
# Embedding Configuration (Optional for local dev)
# ============================================
# Note: For document parsing only, embedding is not required.
# It's only needed for RAG query functionality.
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
EMBEDDING_BINDING_API_KEY=your_openai_api_key_here

# ============================================
# Alternative: OpenAI Direct Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================
# macOS Specific Configuration
# ============================================
# Device selection for macOS
# - cpu: Use CPU (most reliable, works on all Macs)
# - mps: Use Metal Performance Shaders (Apple Silicon only, experimental)
DEVICE=cpu

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
VERBOSE=false
LOG_DIR=/app/logs

